{
  "name": "casino-engine",
  "version": "0.1.0",
  "description": "Moteurs logiques Blackjack, Texas Hold'em et Roulette Européenne, agnostiques de toute UI, avec une interface web de démonstration.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test",
    "demo:roulette": "vite-node examples/roulette-round.ts",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
